#!/bin/sh

# 依存の版が意図せず動くのは lockfile の変更だけで検出する。
node scripts/check-lockfile-commit.mjs
if [ $? -ne 0 ]; then
  exit 1
fi

# check はファイルを書き換えない。書き換えが必要なら `bun run fix` を別に実行する。
echo "Running lint, format check, and type checking..."
bun run check
if [ $? -ne 0 ]; then
  echo "Checks failed. Fix them, or run 'bun run fix' and review the diff, before committing."
  exit 1
fi

echo "All pre-commit checks passed."
