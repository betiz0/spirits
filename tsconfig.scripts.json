{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["bun"],
		// Bun's types are installed for packages/spirits only, and this config lives at the root.
		"typeRoots": ["./packages/spirits/node_modules/@types", "./node_modules/@types"],
		// The scripts measure the host the extension is typed against, which is the official package
		// pinned in packages/spirits, not this checkout's copy of the same package name. Without these
		// entries a script under scripts/ resolves through the root workspace link and gets checked
		// against the fork's sources. The host's ./rpc-entry export ships no type declaration, so it
		// is deliberately absent: a script that imported it would fail to check.
		"paths": {
			"@earendil-works/pi-coding-agent": ["./packages/spirits/node_modules/@earendil-works/pi-coding-agent/dist/index.d.ts"],
			"@earendil-works/pi-tui": ["./packages/spirits/node_modules/@earendil-works/pi-tui/dist/index.d.ts"]
		}
	},
	"include": [
		"scripts/build-binaries.ts",
		"scripts/build-managed-pi-inputs.ts",
		"scripts/check-managed-pi-bundle-version.ts",
		"scripts/managed-pi-compat/**/*.ts"
	],
	// fixtures/redacted-agent/ is redacted user data copied into a temporary agent dir by the data
	// observations. Its extension source is measured input, not code this repo runs.
	"exclude": ["scripts/managed-pi-compat/fixtures/redacted-agent/**"]
}
