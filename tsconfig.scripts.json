{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["bun"],
		// Bun's types are installed for packages/spirits only, and this config lives at the root.
		"typeRoots": [
			"./packages/spirits/node_modules/@types",
			"./node_modules/@types"
		],
		// The scripts measure the host the extension is typed against: the official package pinned in
		// packages/spirits, which is the only place this repository installs it (`bun.lock` has no host
		// entry for the root workspace, and the root has no `paths` indirection left). Naming the package
		// here is what makes a script under scripts/ resolve the host where the product does. The host's
		// ./rpc-entry export ships no type declaration, so it is deliberately absent: a script that
		// imported it would fail to check.
		"paths": {
			"@earendil-works/pi-coding-agent": [
				"./packages/spirits/node_modules/@earendil-works/pi-coding-agent/dist/index.d.ts"
			],
			"@earendil-works/pi-tui": [
				"./packages/spirits/node_modules/@earendil-works/pi-tui/dist/index.d.ts"
			]
		}
	},
	"include": [
		"scripts/build-binaries.ts",
		"scripts/build-managed-pi-inputs.ts",
		"scripts/check-managed-pi-bundle-version.ts",
		"scripts/managed-pi-compat/**/*.ts"
	],
	// fixtures/redacted-agent/ is redacted user data copied into a temporary agent dir by the data
	// observations. Its extension source is measured input, not code this repo runs.
	"exclude": ["scripts/managed-pi-compat/fixtures/redacted-agent/**"]
}
