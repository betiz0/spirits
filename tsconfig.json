{
	// The repository view, for editors and `tsserver`: every TypeScript file in the repo, resolved the
	// way the product resolves it. The checks themselves run the two narrow projects, because they want
	// different option sets and different failure messages: `tsconfig.scripts.json` for `scripts/`
	// (`npm run check:scripts`) and `packages/spirits/tsconfig.json` for the product
	// (`npm run check:spirits`).
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["bun"],
		// Bun's types are installed for packages/spirits, and this config lives at the root.
		"typeRoots": [
			"./packages/spirits/node_modules/@types",
			"./node_modules/@types"
		],
		// The host is the official package pinned in packages/spirits, and only that package's install
		// tree contains it: `bun.lock` has no host entry for the root workspace. Naming the package
		// here is what keeps a file opened at the root from resolving the host somewhere else.
		// The host's ./rpc-entry export ships no type declaration, so it is deliberately absent.
		"paths": {
			"@earendil-works/pi-coding-agent": [
				"./packages/spirits/node_modules/@earendil-works/pi-coding-agent/dist/index.d.ts"
			],
			"@earendil-works/pi-tui": [
				"./packages/spirits/node_modules/@earendil-works/pi-tui/dist/index.d.ts"
			]
		}
	},
	"include": [
		"packages/spirits/src/**/*.ts",
		"packages/spirits/test/**/*.ts",
		"packages/spirits/bin/**/*.ts",
		"scripts/**/*.ts"
	],
	"exclude": [
		"**/node_modules/**",
		"**/dist/**",
		"packages/spirits/test/fixtures/architecture",
		// Loaded *inside* the host: the compatibility runner copies these extension sources into a
		// temporary managed set and the host resolves `@earendil-works/*` from its own install, so they
		// are not files of this repository's import graph. `tsconfig.scripts.json` still type-checks them
		// against the pinned host types.
		"scripts/managed-pi-compat/fixtures/**"
	]
}
