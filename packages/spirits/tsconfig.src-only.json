{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"target": "es2023",
		"module": "NodeNext",
		"moduleResolution": "nodenext",
		"rootDir": ".",
		"skipLibCheck": true,
		"strict": true,
		"types": ["bun"]
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/types/pi-coding-agent.d.ts", "src/types/pi-tui.d.ts"]
}
