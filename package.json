{
	"name": "spirits",
	"version": "0.0.3",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/spirits"
	],
	"scripts": {
		"check": "biome check --error-on-warnings . && bun run check:scripts && bun run check:spirits",
		"check:scripts": "tsc -p tsconfig.scripts.json --noEmit",
		"check:spirits": "cd packages/spirits && bun run check",
		"fix": "biome check --write --error-on-warnings .",
		"test": "cd packages/spirits && bun run test",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"husky": "9.1.7",
		"typescript": "7.0.2"
	},
	"engines": {
		"bun": ">=1.4.0",
		"node": ">=16.20.0"
	}
}
