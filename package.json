{
	"name": "spirits",
	"version": "0.0.3",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/spirits"
	],
	"scripts": {
		"check": "biome check --write --error-on-warnings . && npm run check:scripts && npm run check:spirits",
		"check:scripts": "tsc -p tsconfig.scripts.json --noEmit",
		"check:spirits": "npm --prefix packages/spirits run check",
		"test": "npm --prefix packages/spirits run test",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"husky": "9.1.7",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
